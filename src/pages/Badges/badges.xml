<div>
    <BlurLoader
            active="currentTranslator.loading"
            fixed="true"
            class="'ml-10'"
    />

    <div
            class="container mx-auto px-10 lg:px-0"
            t-if="!currentTranslator.loading"
    >

        <div class="py-10">
            <h3 class="text-slate-600 font-light text-2xl mb-1">
                Compassion
            </h3>

            <h1 class="text-slate-700 font-light text-5xl">
                Badges &amp; Achievements
            </h1>
        </div>

        <div
                t-if="state.loadError"
                class="bg-white border border-slate-200 rounded-sm py-16 px-6 text-center shadow-lg mb-10"
        >

            <h2 class="text-lg font-medium text-slate-700 mb-2">
                Unable to load your achievements
            </h2>

            <p class="text-sm text-slate-400 max-w-md mx-auto">
                An error occurred while retrieving your badges. Please try again later.
            </p>

        </div>

        <div
                t-elif="state.badgesCategories and state.badgesCategories.length > 0"
        >

            <t
                    t-foreach="state.badgesCategories"
                    t-as="catGroup"
                    t-key="catGroup.category"
            >

                <div class="badges-category mb-10">

                    <div class="flex items-center gap-4 mb-5">

                        <div class="flex-1">
                            <h2 class="text-xl font-light text-slate-700">
                                <t t-esc="_(catGroup.category)"/>
                            </h2>

                            <div class="h-px bg-slate-200 mt-3"></div>
                        </div>

                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">

                        <t
                                t-foreach="catGroup.badges"
                                t-as="badge"
                                t-key="badge.id"
                        >

                            <div
                                    t-attf-class="
                  group relative flex flex-col
                  min-h-[300px]
                  p-6
                  rounded-sm
                  border
                  transition-all duration-200
                  {{ badge.is_unlocked
                    ? 'border-slate-200 bg-white shadow-sm hover:-translate-y-1 hover:shadow-md'
                    : 'border-slate-200 bg-slate-50 opacity-70' }}
                "
                                    t-att-title="badge.description"
                            >

                                <div class="absolute top-4 left-4" t-if="badge.type === 'campaign'">
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-sm bg-amber-100 text-amber-700 text-[10px] font-bold uppercase tracking-wider">
                                        <Icon icon="'star'"/> Event
                                    </span>
                                </div>

                                <div class="absolute top-4 right-4">

                                    <t t-if="badge.is_unlocked">

                                        <span
                                                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-sm bg-slate-100 text-compassion text-xs font-medium"
                                        >
                                            Unlocked
                                        </span>

                                    </t>

                                </div>

                                <div class="flex justify-center pt-5 pb-5">

                                    <div
                                            t-attf-class="
                      flex items-center justify-center
                      w-24 h-24
                      rounded-full
                      overflow-hidden
                      transition-transform duration-200
                      {{ badge.is_unlocked
                        ? (badge.type === 'campaign' ? 'bg-gradient-to-tr from-amber-100 to-yellow-50 group-hover:scale-105 shadow-inner' : 'bg-slate-50 group-hover:scale-105')
                        : 'bg-slate-100' }}
                    "
                                    >

                                        <img
                                                t-att-src="badge.icon_url"
                                                t-att-alt="badge.name"
                                                t-attf-class="w-full h-full object-cover rounded-full {{ badge.is_unlocked ? '' : 'grayscale' }}"
                                        />

                                    </div>

                                </div>

                                <h3 class="text-base font-medium text-slate-700 text-center leading-tight mb-2">
                                    <t t-esc="badge.name"/>
                                </h3>

                                <p class="text-sm text-slate-500 text-center leading-relaxed min-h-[40px]">
                                    <t t-esc="badge.description"/>
                                </p>

                                <t t-if="!badge.is_unlocked and badge.threshold > 0">

                                    <div class="badge-progress mt-auto pt-5">

                                        <div class="flex justify-between items-center mb-2">

                                            <span class="text-xs font-medium text-slate-500">
                                                Progress
                                            </span>

                                            <span class="text-xs font-medium text-slate-700">
                                                <t t-esc="badge.current"/>
                                                /
                                                <t t-esc="badge.threshold"/>
                                            </span>

                                        </div>

                                        <div class="w-full h-2 bg-slate-100 rounded-sm overflow-hidden">
                                            <div
                                                    class="h-full bg-compassion rounded-sm transition-all duration-500"
                                                    t-attf-style="width: {{ Math.min(Math.round(badge.progress * 100), 100) }}%"
                                            ></div>
                                        </div>

                                        <div class="text-right mt-1">
                                            <span class="text-[11px] text-slate-400">
                                                <t t-esc="Math.round(badge.progress * 100)"/>%
                                            </span>
                                        </div>

                                    </div>

                                </t>

                                <t t-if="badge.is_unlocked">

                                    <div class="mt-auto pt-5 text-center">

                                        <div class="h-px bg-slate-100 mb-3"></div>

                                        <span class="text-xs font-medium text-compassion">
                                            Achievement unlocked
                                        </span>

                                    </div>

                                </t>

                                <t t-if="!badge.is_unlocked">

                                    <t t-if="badge.days_until_start !== false">

                                        <div class="mt-auto pt-5 text-center">

                                            <div class="h-px bg-slate-200 mb-3"></div>

                                            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500">
                                                Starts on
                                                <t t-esc="badge.start_date"/>
                                            </span>

                                        </div>

                                    </t>

                                    <t t-elif="badge.days_left !== false">

                                        <div class="mt-auto pt-5 text-center">

                                            <div class="h-px bg-slate-200 mb-3"></div>

                                            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500">


                                                <t t-if="badge.is_finished">
                                                    Ended
                                                </t>

                                                <t t-elif="badge.days_left > 0">
                                                    <t t-esc="badge.days_left"/>
                                                    days left
                                                </t>

                                                <t t-else="">
                                                    Ends today!
                                                </t>

                                            </span>

                                        </div>

                                    </t>

                                    <t t-else="">

                                        <t t-if="!badge.threshold or badge.threshold === 0">

                                            <div class="mt-auto pt-5 text-center">

                                                <div class="h-px bg-slate-200 mb-3"></div>

                                                <span class="text-xs font-medium text-slate-400">
                                                    Locked
                                                </span>

                                            </div>

                                        </t>

                                    </t>

                                </t>

                            </div>

                        </t>

                    </div>

                </div>

            </t>

        </div>

        <div
                t-else=""
                class="bg-white border border-slate-200 rounded-sm py-16 px-6 text-center shadow-lg mb-10"
        >

            <h2 class="text-lg font-medium text-slate-700 mb-2">
                No achievements yet
            </h2>

            <p class="text-sm text-slate-400 max-w-md mx-auto">
                No badges available yet. Come back soon!
            </p>

        </div>

    </div>
</div>