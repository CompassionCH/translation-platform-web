<div>
    <BlurLoader
            active="state.loading or currentTranslator.loading"
            fixed="true"
            class="'ml-10'"
    />

    <RankingRulesModal
            active="state.rulesModal"
            onClose="() => this.state.rulesModal = false"
            leaderboard="selectedLeaderboard"
    />

    <div
            class="container mx-auto px-10 lg:px-0 max-w-3xl"
            t-if="!state.loading and !currentTranslator.loading"
    >

        <div class="py-10 flex items-end justify-between gap-4">
            <div>
                <h3 class="text-slate-600 font-light text-2xl mb-1">
                    Compassion
                </h3>

                <h1 class="text-slate-700 font-light text-5xl">
                    Leaderboard
                </h1>
            </div>

            <Button size="'sm'" level="'secondary'" icon="'circle-question'" onClick="() => this.state.rulesModal = true">
                How ranking works
            </Button>
        </div>

        <t t-if="state.leaderboards.length > 0">

            <div class="leaderboard-tabs flex gap-2 border-b border-slate-200 mb-6">
                <t t-foreach="state.leaderboards" t-as="leaderboard" t-key="leaderboard.id">
                    <button
                            t-attf-class="px-4 py-2 -mb-px text-sm border-b-2 transition-colors {{ leaderboard.id === state.selectedId ? 'border-compassion text-compassion font-medium' : 'border-transparent text-slate-500 hover:text-slate-700' }}"
                            t-on-click="() => this.select(leaderboard.id)"
                            t-esc="tabLabel(leaderboard)"
                    />
                </t>
            </div>

            <div class="relative">
                <BlurLoader active="state.rankingLoading" />

                <t t-if="state.ranking">

                    <div class="flex flex-wrap items-start justify-between gap-2 mb-5">
                        <div>
                            <h2 class="text-xl font-light text-slate-700" t-esc="leaderboardName(state.ranking.leaderboard)" />
                            <p class="text-sm text-slate-500">
                                <t t-esc="formatDate(state.ranking.leaderboard.startAt)" />
                                –
                                <t t-esc="formatDate(state.ranking.leaderboard.endAt)" />
                            </p>
                        </div>
                        <div class="text-right">
                            <span
                                    t-attf-class="inline-block px-2.5 py-1 rounded-sm text-xs font-medium {{ state.ranking.leaderboard.state === 'live' ? 'bg-slate-100 text-compassion' : 'bg-amber-100 text-amber-700' }}"
                                    t-esc="periodStatus(state.ranking.leaderboard, state.now)"
                            />
                        </div>
                    </div>

                    <!-- Users without any point see an encouraging message instead of a rank and of the competitors -->
                    <div
                            t-if="state.ranking.myRank === false"
                            class="bg-white border border-slate-200 rounded-sm py-16 px-6 text-center shadow-lg mb-10"
                    >
                        <p class="text-slate-600" t-esc="joinRankingText(state.ranking.leaderboard)" />
                    </div>

                    <t t-else="">
                        <div class="my-position bg-white border border-slate-200 rounded-sm shadow-sm px-5 py-4 mb-5 text-center">
                            <p class="text-slate-700" t-esc="myPositionText(state.ranking.leaderboard, state.ranking.myRank, state.ranking.participantCount)" />
                        </div>

                        <div class="ranking-list bg-white border border-slate-200 rounded-sm shadow-sm overflow-hidden mb-10">
                            <t t-foreach="state.ranking.top" t-as="entry" t-key="'top-' + entry.rank">
                                <RankingRow entry="entry" anonymous="isAnonymous" />
                            </t>

                            <div t-if="state.ranking.showSeparator" class="flex items-center justify-center py-1 bg-slate-50 border-b border-slate-100 text-slate-400 tracking-widest">
                                ···
                            </div>

                            <t t-foreach="state.ranking.around" t-as="entry" t-key="'around-' + entry.rank">
                                <RankingRow entry="entry" anonymous="isAnonymous" />
                            </t>

                            <t t-foreach="state.ranking.notRanked" t-as="entry" t-key="'not-ranked-' + entry_index">
                                <RankingRow entry="entry" anonymous="isAnonymous" />
                            </t>
                        </div>
                    </t>

                </t>
            </div>

        </t>

        <div
                t-else=""
                class="bg-white border border-slate-200 rounded-sm py-16 px-6 text-center shadow-lg mb-10"
        >
            <h2 class="text-lg font-medium text-slate-700 mb-2">
                No leaderboard available
            </h2>
            <p class="text-sm text-slate-400 max-w-md mx-auto">
                Come back soon to see how you rank among other translators.
            </p>
        </div>

    </div>
</div>
